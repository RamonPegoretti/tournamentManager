# Postgres connection string (local Postgres, or the Neon database added from Vercel > Storage)
DATABASE_URL=postgres://postgres@localhost:5432/tm

# Better Auth: a long random string (openssl rand -base64 32) and the site's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000  # on Vercel this can be left unset
